# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Google Earth Engine Service Account (single line JSON)
# Get this from Google Cloud Console → IAM & Admin → Service Accounts
GEE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}

# Backend URL (set this to your deployed Render URL)
BACKEND_EXTERNAL_URL=https://your-backend.onrender.com

